# Server Configuration
PORT=5000
NODE_ENV=development
# Turso Database - libSQL over HTTP (works on Vercel serverless)
# Local dev: TURSO_DATABASE_URL="file:./prisma/dev.db" (no token needed)
# Production: get URL + token from https://turso.tech
TURSO_DATABASE_URL="libsql://your-db-name-youruser.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token-here"
CORS_ORIGIN="http://localhost:5173"

# Google Gemini AI (or OpenAI / Mock)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash

# Lead Discovery (SerpAPI)
SERPAPI_API_KEY=your_serpapi_api_key_here

# Gmail OAuth 2.0 Integration (Alternative 1)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/gmail/callback
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token_here

# SMTP Integration using App Password (Alternative 2 - Simpler)
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_digit_app_password

# OpenWA WhatsApp Gateway
# OpenWA serves its REST API on port 2785 by default.
OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=owa_k1_your_openwa_api_key_here
OPENWA_SESSION_ID=default
OPENWA_PRECHECK_CONTACTS=false
