generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id            Int      @id @default(autoincrement())
  businessName  String
  category      String?
  city          String?
  address       String?
  website       String?
  mapsUrl       String?
  phone         String?
  email         String?
  rating        Float?
  reviewCount   Int?
  websiteStatus String   @default("UNKNOWN")
  score         Int      @default(0)
  temperature   String   @default("LOW")
  status        String   @default("NEW")
  source        String   @default("MANUAL")
  followUpStep  Int      @default(0)
  nextFollowUpAt DateTime?
  lastContactedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([temperature])
  @@index([city])
  @@index([category])
  @@index([nextFollowUpAt])
}

model Template {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  channel     String   @default("EMAIL") // EMAIL, WHATSAPP
  subject     String?
  body        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([channel])
  @@index([isActive])
}

model SentMessage {
  id           Int      @id @default(autoincrement())
  leadId       Int?
  recipient    String
  subject      String
  body         String
  channel      String   @default("EMAIL") // EMAIL, WHATSAPP
  provider     String   @default("GMAIL") // GMAIL, MOCK
  messageId    String?  // External provider ID
  threadId     String?
  status       String   @default("SENT")  // SENT, FAILED
  errorMessage String?
  sentAt       DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([leadId])
  @@index([recipient])
  @@index([status])
}

model Approval {
  id            Int      @id @default(autoincrement())
  leadId        Int?
  templateId    Int?
  channel       String   @default("EMAIL")            // EMAIL, WHATSAPP
  recipient     String
  subject       String?
  body          String
  status        String   @default("PENDING_APPROVAL") // DRAFT | PENDING_APPROVAL | APPROVED | REJECTED | SENT | FAILED
  reviewNote    String?                               // Reviewer comment on rejection
  sentMessageId Int?                                  // Linked SentMessage record after dispatch
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([leadId])
}

model Campaign {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  city        String?
  category    String?
  templateId  Int
  channel     String   @default("EMAIL")  // EMAIL | WHATSAPP
  dailyLimit  Int      @default(20)
  status      String   @default("DRAFT")  // DRAFT | ACTIVE | PAUSED | COMPLETED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([templateId])
}

model FollowUpSchedule {
  id          Int      @id @default(autoincrement())
  leadId      Int
  templateId  Int?
  step        Int      @default(1) // 1, 2, 3, 4
  scheduledAt DateTime
  status      String   @default("SCHEDULED") // SCHEDULED | QUEUED_FOR_APPROVAL | SKIPPED | CANCELLED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([scheduledAt])
  @@index([leadId])
}

model FollowUpConfig {
  id        Int      @id @default(autoincrement())
  name      String   @default("Default Sequence")
  intervals String   @default("1,3,7,10") // Comma-separated day offsets (e.g. Day 1, 3, 7, 10)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reply {
  id            Int      @id @default(autoincrement())
  leadId        Int?
  sentMessageId Int?
  threadId      String
  messageId     String   @unique
  sender        String
  subject       String?
  body          String
  replyAt       DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([leadId])
  @@index([threadId])
  @@index([sender])
}

// Persistent key-value store for application settings
// Stores AI provider/model, sender profile, scoring rules, outreach preferences
model AppSettings {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String?
  category  String   @default("general") // ai | outreach | scoring | profile | general
  label     String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([category])
}
